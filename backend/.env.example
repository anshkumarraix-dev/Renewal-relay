# ==============================================================================
# Renewal Relay - Backend Environment Configuration (.env.example)
# Copy this file to backend/.env for local backend development
# ==============================================================================

# Application Runtime Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Renewal Relay Backend
APP_VERSION=0.1.0

# Server Bindings
HOST=127.0.0.1
PORT=8000

# CORS Configuration
# Local frontend development origin only. Wildcards are strictly prohibited when credentials are enabled.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (SQLite local file)
DATABASE_URL=sqlite:///./renewal_relay.db

# PayPal REST API Configuration (SANDBOX ONLY)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# Governance and Security Gates
ENFORCE_DETERMINISTIC_POLICY=true
ALLOW_AI_AUTONOMOUS_PAYMENT=false
