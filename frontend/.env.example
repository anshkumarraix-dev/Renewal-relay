# ==============================================================================
# Renewal Relay - Frontend Environment Configuration (.env.example)
# Copy this file to frontend/.env for local frontend development
#
# SECURITY WARNING:
# Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER place PayPal client secrets, private keys, or credentials here.
# ==============================================================================

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Environment Name
VITE_APP_ENV=development
