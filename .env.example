# ==============================================================================
# Renewal Relay - Master Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit actual credentials or secrets to version control.
# 2. Local development must strictly use PayPal Sandbox credentials.
# 3. PayPal remains the payment authority; the backend verifies all actions.
# 4. Frontend must NEVER receive or store PAYPAL_CLIENT_SECRET.
# ==============================================================================

# Application Runtime Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Renewal Relay
APP_VERSION=0.1.0

# Server Bindings
HOST=127.0.0.1
PORT=8000

# CORS Configuration (Restricted to local development origins; no wildcards with credentials)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Connection (SQLite for local development)
DATABASE_URL=sqlite:///./renewal_relay.db

# PayPal REST API Configuration (SANDBOX ONLY for development)
# Mode must be set to 'sandbox' during all testing and local development
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# Governance and Policy Controls
# Ensures all renewal recovery attempts pass deterministic rule checks and merchant auth
ENFORCE_DETERMINISTIC_POLICY=true
ALLOW_AI_AUTONOMOUS_PAYMENT=false

# Frontend Configuration (Reference for frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
